# Beta Entry-P: Tunnel (host network) → Caddy :8080 → FE + API/WS.
# Caddy also uses host networking so upstream is 127.0.0.1:8000 (backend systemd).
# TLS at Cloudflare edge.

# Listen on loopback only (Access protects the public hostname; do not bind :8080 on
# the public NIC). Use bind + bare :8080 — NOT `http://127.0.0.1:8080` — so Caddy does
# not require Host: 127.0.0.1. Cloudflare Tunnel forwards Host: my-ai-pen.oak-studio.org;
# a host-matched site returns 200 with an empty body → white screen, zero /assets/* fetches.
# auto_https off: plain HTTP for the tunnel hop.
{
	auto_https off
}

:8080 {
	bind 127.0.0.1
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /ws* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
