# Copy to platform/.env (or export before compose) on the beta host. Never commit real values.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=pentest_platform

RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me-strong-mq-password

# Cloudflare Tunnel token (from Zero Trust dashboard) — required for public edge
TUNNEL_TOKEN=
