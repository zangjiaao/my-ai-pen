# Node4 runtime — copy to `.env` and fill values. Do not commit secrets.
# Loaded by `src/env.ts` (does not override vars already set in the shell).
# Living sandbox strategy: docs/specs/pen-tools-sandbox.md

# ---------------------------------------------------------------------------
# Platform binding (required for product mode)
# ---------------------------------------------------------------------------
NODE_NAME=node-dev-1
NODE_TOKEN=
PLATFORM_WS_URL=ws://127.0.0.1:8000/ws
# Optional HTTP base for ledger tools (else derived from PLATFORM_WS_URL)
# PLATFORM_HTTP_URL=http://127.0.0.1:8000
# PLATFORM_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Model / LLM
# ---------------------------------------------------------------------------
PI_MODEL_PROVIDER=deepseek
PI_MODEL=deepseek-v4-flash
# PI_MODEL_REASONING=true
PI_AGENT_DIR=.pi-agent

# API key (provider-specific or generic)
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_API_KEY=

# Compatible OpenAI-style gateway (optional)
# LLM_BASE_URL=
# OPENAI_BASE_URL=
# LLM_API=openai-completions
# LLM_CONTEXT_WINDOW=128000
# LLM_MAX_TOKENS=8192

# Optional USD cost rates (per million tokens) for usage accounting
# LLM_COST_INPUT_PER_MTOK=0
# LLM_COST_OUTPUT_PER_MTOK=0
# LLM_COST_CACHE_READ_PER_MTOK=
# LLM_COST_CACHE_WRITE_PER_MTOK=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# NODE4_WORKSPACE=./workspace
# NODE4_EXPERTS_INSTALL=
# NODE4_EXPERTS_CATALOG=
# NODE4_MAIN_MAX_TURNS=200

# ---------------------------------------------------------------------------
# pen-sandbox / browser / shell  (Spec #320 / #330)
# ---------------------------------------------------------------------------
# Browser sandbox path requires an EXPLICIT first-party image pin.
# Missing pin → hard failure of sandbox path (no Strix / ambient-tag default).
# Build: bash sandbox/pen-sandbox/scripts/build.sh
PEN_SANDBOX_IMAGE=pen-sandbox:dev

# Browser override (wins over PEN_SANDBOX_IMAGE when set)
# NODE4_BROWSER_SANDBOX_IMAGE=

# Shell image override (same image family; also accepted as browser pin if set)
# PEN_TOOLS_IMAGE=

# Browser: 1 (default) = Docker sandbox preferred; 0|false|off|host = host agent-browser only
# NODE4_BROWSER_SANDBOX=1

# Shell-in-container: auto (default) | 1 | 0
# NODE4_SHELL_IN_PEN_TOOLS=auto

# Host PATH shim for pen-tools CLIs: 1 (default) | 0
# NODE4_PEN_TOOLS=1
# NODE4_PEN_TOOLS_BIN=
# PEN_TOOLS_BIN=

# Docker / network / templates
# NODE4_DOCKER_BIN=docker
# PEN_TOOLS_NETWORK=host
# PEN_TOOLS_NUCLEI_TEMPLATES=~/.cache/pen-tools/nuclei-templates

# Host agent-browser binary (when sandbox disabled or host fallback)
# NODE4_AGENT_BROWSER_BIN=agent-browser
# AGENT_BROWSER_BIN=agent-browser

# ---------------------------------------------------------------------------
# Subagents
# ---------------------------------------------------------------------------
# NODE4_SUBAGENT_CONCURRENCY=8
# NODE4_SUBAGENT_TASK_BUDGET=128
# NODE4_SUBAGENT_TIMEOUT_MS=600000
# NODE4_SUBAGENT_DRY=0

# ---------------------------------------------------------------------------
# Loop / goal / stream health (optional)
# ---------------------------------------------------------------------------
# NODE4_MAX_CONTINUES=16
# NODE4_MAX_CONTINUES_DEFAULT=
# NODE4_MAX_EMPTY_STOPS=
# NODE4_MAX_PREMATURE_STOPS=3
# NODE4_MAX_GOAL_CONTINUES=          # unset/0 = off; or unlimited | positive int
# NODE4_GOAL_REQUIRE_CLEARANCE=0
# NODE4_GOAL_MIN_CONTINUES=0
# NODE4_GOAL_MIN_STALLS=0
# NODE4_GOAL_MIN_AUDIT_CHARS=120
# NODE4_LLM_STALL_MS=
# NODE4_LLM_IDLE_ABORT_MS=

# ---------------------------------------------------------------------------
# Hard Graph L1 critic (optional)
# ---------------------------------------------------------------------------
# NODE4_L1_MAX_STAGE_REFINE=
# NODE4_L1_YIELD_REFINE=0
# NODE4_L1_UNDER_SEVERITY_REFINE=0

# Graph: allow command-style subagent packages (default off)
# NODE4_GRAPH_ALLOW_COMMAND_SUB=0
